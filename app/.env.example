DATABASE_URL=postgresql://apex:CHANGE_ME@db:5432/apex
APP_URL=https://apex.mr-gadget.xyz
BOOTSTRAP_EMAIL=owner@example.com
# At least 16 characters. Used only when creating the first organiser.
BOOTSTRAP_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CALENDAR_SYNC_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEMO_MODE=false
BACKUP_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Runtime image folder mounted read-only by Compose.
BANNER_IMAGE_DIR=/app/images

# Public GitHub repository hosting releases, e.g. your-name/apex-league.
UPDATES_REPOSITORY=Sietsevdm/Apex-League
APEX_IMAGE=ghcr.io/sietsevdm/apex-league:0.8.7
